# AI交易员 独立部署环境变量模板
#
# 用法：复制为 trading.env，填好值后随守护脚本启动：
#   set -a; source trading.env; set +a
#   node scripts/trading-agent.mjs
#
# 同一个 easy-stock-server.exe，配了 A_STOCK_TRADING_ONLY=1 就是独立的
# AI交易员程序：路由只留 /api/v1/trading/* 与设置/LLM 配置，
# 调度器只跑交易自动循环，研究侧模块完全不加载。

# ── 模式与端口 ────────────────────────────────────────────────
A_STOCK_TRADING_ONLY=1
# 对局域网其他机器开放就写 0.0.0.0，只在本机用保持 127.0.0.1
A_STOCK_ADDR=0.0.0.0:20081
# 守护脚本的静态页面端口（AI交易员界面）
A_STOCK_WEB_ADDR=0.0.0.0:20073

# ── QuantMind 研究所（局域网 API，K线/快照/资金流主源）─────────
# 地址 + 账号密码四项齐全才启用；缺任何一项自动退回东财→新浪兜底，
# 日志里会出现 quantmind_disabled 警示。
# 本文件会进 git，不要把内网地址与真实凭据写在这里——
# 实际值放部署机的本地 env（如 .runtime/quantmind.env，已 gitignore）。
A_STOCK_QUANTMIND_URL=http://<QuantMind主机内网IP>:8000
A_STOCK_QUANTMIND_TENANT=
A_STOCK_QUANTMIND_USER=
A_STOCK_QUANTMIND_PASSWORD=

# ── 本机持久化 ────────────────────────────────────────────────
# 交易账本（唯一必须落盘的业务数据）
A_STOCK_TRADING_DB=./data/trading.db
# LLM 配置、通知渠道等设置
A_STOCK_SETTINGS_PATH=./data/settings.json
# 交易告警日志（配了 webhook 时告警同时落这里）
A_STOCK_LOG_DIR=./data/logs
# LLM 网关运行时（agent 包调用大模型所必需，随程序一起分发）
# A_STOCK_CODEX_RUNTIME_ROOT=./runtime/codex-runtime
# A_STOCK_HERMES_RUNTIME_ROOT=./runtime/hermes-runtime

# ── 可选 ──────────────────────────────────────────────────────
# API 访问令牌：设置后所有请求需带 Authorization: Bearer <token>
# A_STOCK_TOKEN=
# 实盘通道（地址+令牌齐全才启用，缺项保持模拟盘）
# A_STOCK_TRADING_BROKER_ENDPOINT=
# A_STOCK_TRADING_BROKER_TOKEN=
